{
  "manifest_version": 3,
  "name": "Password Store",
  "version": "0.1.0",
  "description": "Local encrypted vault for passwords and files. Your data never leaves this device.",
  "action": {
    "default_title": "Open Password Store"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
